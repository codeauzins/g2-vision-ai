# Copy to even-app/.env.local (never commit real values).

# Your Render URL, no trailing slash.
VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com

# Same value as G2_DEVICE_SECRET on Render. Not the OpenAI key.
VITE_DEVICE_SECRET=

# true = local demo answer, no backend/OpenAI.
VITE_MOCK_API=false
