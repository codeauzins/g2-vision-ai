# Copy this file to even-app/.env.local
# These are NOT Render dashboard variables. They are baked into the glasses
# app when you run `npm run dev:app` or `npm run pack` on your Mac.

# Backend the glasses will poll. Already the default in code too.
VITE_API_BASE_URL=https://g2-vision-ai.onrender.com

# Paste the SAME value you set as G2_DEVICE_SECRET on Render.
# This is not the OpenAI key.
VITE_DEVICE_SECRET=

# Keep false for real photos. true = fake long answer, no server.
VITE_MOCK_API=false
