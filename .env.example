# Copy to backend/.env (and even-app/.env.local if you want local overrides).
# Never commit real values.

# --- Render / backend ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
G2_DEVICE_SECRET=
G2_ADMIN_PASSWORD=
G2_DATA_DIR=/var/data2
PORT=8787
RESULT_TTL_SECONDS=604800
MAX_UPLOAD_MB=8
IMAGE_MAX_EDGE=1600
IMAGE_JPEG_QUALITY=80
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Even Hub app (Mac build only — not Render env vars) ---
# Copy even-app/.env.example → even-app/.env.local
# VITE_API_BASE_URL=https://g2-vision-ai.onrender.com
# VITE_DEVICE_SECRET=
# VITE_MOCK_API=false
